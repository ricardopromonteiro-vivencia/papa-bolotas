# Papa Bolotas Webapp - Local Environment Configuration
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these values from: Supabase Dashboard > Project Settings > API
# Documentation: https://supabase.com/docs/guides/api

# Your Supabase project URL (format: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public API key
# This key is safe to expose in the client as it's protected by Row Level Security
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application name displayed in the UI
VITE_APP_NAME=Papa Bolotas

# Application version (keep in sync with package.json)
VITE_APP_VERSION=0.1.0

# =============================================================================
# SECURITY CONFIGURATION (Required)
# =============================================================================

# Security code required for sensitive operations (order cancellation, admin functions)
# Change this to a secure numeric code (recommended: 4-6 digits)
# Requirement 15.10: Store sensitive configuration as environment variables
VITE_SECURITY_CODE=1234

# =============================================================================
# DEVELOPMENT CONFIGURATION (Optional)
# =============================================================================

# Enable development mode features (verbose logging, debug tools)
# Automatically set based on NODE_ENV, but can be overridden
# VITE_DEV_MODE=true

# Enable mock data for development without database connection
# VITE_USE_MOCK_DATA=false

# =============================================================================
# NOTES
# =============================================================================
# - All environment variables must be prefixed with VITE_ to be accessible in the client
# - Vite exposes these variables at build time, they are NOT dynamic at runtime
# - Never commit actual credentials to version control
# - For production, set these variables in your hosting platform (Netlify, Vercel, etc.)
# - Requirement 17.3: Supabase authentication uses secure API keys
